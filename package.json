{
  "name": "label-lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Scan a barcode, understand the label. Zero backend, zero tracking.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:wdio": "wdio run wdio.conf.js",
    "test:standalone": "mocha"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@wdio/cli": "^9.31.9",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "eslint": "^9.17.0",
    "expect-webdriverio": "^6.0.10",
    "globals": "^17.12.0",
    "mocha": "^12.0.1",
    "properties-reader": "^3.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "webdriverio": "^9.31.9"
  }
}
